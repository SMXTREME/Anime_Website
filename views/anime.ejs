<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= name %> - AniXTREME</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Arial', sans-serif;
            }

            body {
                background-color: #0f1016;
                color: #fff;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 20px;
            }

            /* Header Styles */
            header {
                background-color: #161921;
                padding: 15px 0;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .logo {
                color: #5abee0;
                font-size: 24px;
                font-weight: bold;
            }

            .logo span {
                color: #fff;
            }

            nav ul {
                display: flex;
                list-style: none;
            }

            nav ul li {
                margin-left: 20px;
            }

            nav ul li a {
                color: #e0e0e0;
                transition: color 0.3s;
            }

            nav ul li a:hover {
                color: #5abee0;
            }

            .search-bar {
                display: flex;
                background-color: #1a1d27;
                border-radius: 20px;
                overflow: hidden;
                width: 250px;
            }

            .search-bar input {
                width: 100%;
                padding: 8px 15px;
                border: none;
                background-color: transparent;
                color: #fff;
                outline: none;
            }

            .search-bar button {
                background-color: #5abee0;
                border: none;
                color: #161921;
                padding: 8px 15px;
                cursor: pointer;
            }

            /* Anime Details */
            .anime-details {
                margin-top: 30px;
                display: flex;
                gap: 30px;
            }

            .anime-poster-container {
                flex: 0 0 300px;
            }

            .anime-poster {
                width: 100%;
                border-radius: 10px;
                overflow: hidden;
            }

            .anime-info {
                flex: 1;
            }

            .anime-title {
                font-size: 32px;
                margin-bottom: 10px;
            }

            .anime-meta {
                display: flex;
                gap: 15px;
                margin-bottom: 20px;
                color: #e0e0e0;
            }

            .meta-item {
                background-color: #1a1d27;
                padding: 5px 12px;
                border-radius: 15px;
                font-size: 14px;
            }

            .meta-item span {
                color: #5abee0;
            }

            .anime-description {
                line-height: 1.6;
                margin-bottom: 25px;
                color: #e0e0e0;
                max-height: 200px;
                overflow-y: auto;
                padding-right: 10px;
            }

            .anime-description::-webkit-scrollbar {
                width: 8px;
            }

            .anime-description::-webkit-scrollbar-track {
                background: #1a1d27;
                border-radius: 4px;
            }

            .anime-description::-webkit-scrollbar-thumb {
                background: #5abee0;
                border-radius: 4px;
            }

            .anime-description::-webkit-scrollbar-thumb:hover {
                background: #4590ad;
            }

            .action-buttons {
                display: flex;
                gap: 15px;
                margin-bottom: 30px;
            }

            .btn {
                padding: 10px 25px;
                border-radius: 20px;
                font-weight: bold;
                cursor: pointer;
                transition: all 0.3s;
            }

            .primary-btn {
                background-color: #5abee0;
                color: #161921;
            }

            .primary-btn:hover {
                background-color: #4590ad;
            }

            .secondary-btn {
                background-color: #1a1d27;
                color: #fff;
                border: 1px solid #5abee0;
            }

            .secondary-btn:hover {
                background-color: #242735;
            }

            /* Tabs */
            .tabs {
                margin: 30px 0;
                border-bottom: 2px solid #1a1d27;
            }

            .tab-buttons {
                display: flex;
                gap: 20px;
            }

            .tab-btn {
                padding: 10px 20px;
                background: none;
                border: none;
                color: #e0e0e0;
                font-size: 16px;
                cursor: pointer;
                position: relative;
            }

            .tab-btn.active {
                color: #5abee0;
            }

            .tab-btn.active::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 100%;
                height: 2px;
                background-color: #5abee0;
            }

            .tab-content {
                padding: 20px 0;
            }

            /* Episodes List */
            .episodes-list {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 15px;
            }

            .episode-card {
                background-color: #1a1d27;
                border-radius: 8px;
                overflow: hidden;
                transition: transform 0.3s;
            }

            .episode-card:hover {
                transform: translateY(-5px);
            }

            .episode-thumbnail {
                width: 100%;
                height: 120px;
                object-fit: cover;
            }

            .episode-info {
                padding: 10px;
            }

            .episode-number {
                font-weight: bold;
                margin-bottom: 5px;
            }

            .episode-title {
                font-size: 14px;
                color: #e0e0e0;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* Characters */
            .characters-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 20px;
            }

            .character-card {
                background-color: #1a1d27;
                border-radius: 8px;
                overflow: hidden;
                transition: transform 0.3s;
            }

            .character-card:hover {
                transform: translateY(-5px);
            }

            .character-image {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

            .character-info {
                padding: 10px;
                text-align: center;
            }

            .character-name {
                font-weight: bold;
                margin-bottom: 3px;
            }

            .character-role {
                font-size: 12px;
                color: #e0e0e0;
            }

            /* Similar Anime */
            .similar-anime {
                margin-top: 40px;
            }

            .section-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .section-title h3 {
                font-size: 22px;
            }

            .view-all {
                color: #5abee0;
                font-size: 14px;
            }

            .anime-list {
                display: flex;
                overflow-x: auto;
                gap: 20px;
                padding-bottom: 15px;
                scroll-behavior: smooth;
            }

            .anime-list::-webkit-scrollbar {
                height: 8px;
            }

            .anime-list::-webkit-scrollbar-track {
                background: #1a1d27;
                border-radius: 4px;
            }

            .anime-list::-webkit-scrollbar-thumb {
                background: #5abee0;
                border-radius: 4px;
            }

            .anime-list::-webkit-scrollbar-thumb:hover {
                background: #4590ad;
            }

            .anime-card {
                flex: 0 0 200px;
                position: relative;
                border-radius: 8px;
                overflow: hidden;
                transition: transform 0.3s;
            }

            .anime-card:hover {
                transform: translateY(-5px);
            }

            .anime-poster-small {
                width: 100%;
                height: 280px;
                object-fit: cover;
            }

            .anime-card-info {
                padding: 10px;
                background-color: #1a1d27;
            }

            .anime-card-title {
                font-size: 16px;
                font-weight: bold;
                margin-bottom: 5px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .episode-count {
                position: absolute;
                top: 10px;
                right: 10px;
                background-color: rgba(0, 0, 0, 0.7);
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 12px;
            }

            .sub-dub {
                position: absolute;
                top: 10px;
                left: 10px;
                background-color: #5abee0;
                color: #161921;
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 12px;
                font-weight: bold;
            }

            /* Footer */
            footer {
                margin-top: 60px;
                background-color: #161921;
                padding: 30px 0;
                color: #e0e0e0;
                font-size: 14px;
                text-align: center;
            }

            /* Comments */
            .comments-section {
                margin-top: 20px;
            }

            .comment {
                background-color: #1a1d27;
                padding: 15px;
                border-radius: 8px;
                margin-bottom: 15px;
            }

            .comment-header {
                display: flex;
                justify-content: space-between;
                margin-bottom: 10px;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .user-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background-color: #5abee0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                color: #161921;
            }

            .username {
                font-weight: bold;
            }

            .comment-date {
                color: #a0a0a0;
                font-size: 12px;
            }

            .comment-content {
                line-height: 1.5;
                color: #e0e0e0;
            }

            /* Add Comment */
            .add-comment {
                margin-top: 20px;
            }

            .comment-textarea {
                width: 100%;
                height: 100px;
                padding: 10px;
                background-color: #1a1d27;
                border: 1px solid #282c3a;
                border-radius: 8px;
                color: #fff;
                margin-bottom: 10px;
                resize: none;
            }

            .comment-textarea:focus {
                outline: none;
                border-color: #5abee0;
            }

            /* Responsive */
            @media (max-width: 768px) {
                .anime-details {
                    flex-direction: column;
                }

                .anime-poster-container {
                    flex: 0 0 auto;
                    max-width: 250px;
                    margin: 0 auto;
                }

                .episodes-list {
                    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                }

                .tab-buttons {
                    overflow-x: auto;
                    padding-bottom: 5px;
                }

                .tab-btn {
                    white-space: nowrap;
                }

                .anime-title {
                    font-size: 24px;
                }
            }

            @media (max-width: 480px) {
                .episodes-list {
                    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                }

                .action-buttons {
                    flex-direction: column;
                    gap: 10px;
                }

                .btn {
                    width: 100%;
                    text-align: center;
                }

                .characters-grid {
                    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
                }

                .anime-meta {
                    flex-wrap: wrap;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <div class="container header-container">
                <div class="logo"><a href="/">ANIXTREME</a></div>
                <nav>
                    <!-- Nav links would go here -->
                </nav>
                <div class="search-bar">
                    <input id="search-bar-data" type="text" placeholder="Search anime..." />
                    <button id="search-bar-button">Search</button>
                </div>
            </div>
        </header>

        <main class="container">
            <section class="anime-details">
                <div class="anime-poster-container">
                    <img src="<%= poster %>" alt="<%= name %> Poster" class="anime-poster" />
                </div>
                <div class="anime-info">
                    <h1 class="anime-title"><%= name %></h1>
                    <div class="anime-meta">
                        <div class="meta-item">Type: <span><%= type %></span></div>
                        <div class="meta-item">Episodes: <span><%= episodes.sub %></span></div>
                        <div class="meta-item">Status: <span><%= status %></span></div>
                        <div class="meta-item">Rating: <span><%= malscore %>/10</span></div>
                    </div>
                    <p class="anime-description"><%= description %></p>
                    <div class="action-buttons">
                        <a href="/watch/<%= firstEpisodeId %>" class="btn primary-btn">Watch Now</a>
                    </div>
                </div>
            </section>

            <section class="similar-anime">
                <div class="section-title">
                    <h3>Similar Anime</h3>
                </div>
                <div class="anime-list">
                    <% related.forEach(data => { %>
                    <a href="/anime/<%= data.id %>" class="anime-card">
                        <div class="sub-dub">
                            <% if (data.episodes.sub > 0 && data.episodes.dub <= 0) { %> SUB <% } %>
                            <% if (data.episodes.sub > 0 && data.episodes.dub > 0) { %> SUB/DUB <% }
                            %>
                        </div>
                        <div class="episode-count">EP <%= data.episodes.sub %></div>
                        <img
                            src="<%= data.poster %>"
                            alt="<%= data.name %>"
                            class="anime-poster-small"
                        />
                        <div class="anime-card-info">
                            <div class="anime-card-title"><%= data.name %></div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </section>
        </main>

        <footer>ANIXTREME, Made with ❤️ by SMXTREME</footer>

        <script>
            // Tab switching functionality
            const tabButtons = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    // Hide all tab contents
                    tabContents.forEach((content) => {
                        content.style.display = 'none';
                    });

                    // Remove active class from all buttons
                    tabButtons.forEach((btn) => {
                        btn.classList.remove('active');
                    });

                    // Add active class to clicked button
                    button.classList.add('active');

                    // Show corresponding tab content
                    const tabId = button.getAttribute('data-tab') + '-tab';
                    document.getElementById(tabId).style.display = 'block';
                });
            });

            // Search functionality
            const searchBar = document.getElementById('search-bar-data');
            const searchButton = document.getElementById('search-bar-button');
            const searchUrl = '/search?q=';

            searchButton.addEventListener('click', () => {
                const query = searchBar.value.trim();
                redirectToSearch(query);
            });

            searchBar.addEventListener('keypress', (event) => {
                if (event.key === 'Enter') {
                    const query = searchBar.value.trim();
                    redirectToSearch(query);
                }
            });

            function redirectToSearch(query) {
                if (query !== '') {
                    window.location.href = searchUrl + query + '&page=1';
                } else {
                    searchBar.value = '';
                }
            }
        </script>
    </body>
</html>
