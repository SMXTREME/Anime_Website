<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>AniXTREME - Watch Anime Online</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Arial', sans-serif;
            }

            body {
                background-color: #0f1016;
                color: #fff;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 20px;
            }

            /* Header Styles */
            header {
                background-color: #161921;
                padding: 15px 0;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .logo {
                color: #5abee0;
                font-size: 24px;
                font-weight: bold;
            }

            .logo span {
                color: #fff;
            }

            nav ul {
                display: flex;
                list-style: none;
            }

            nav ul li {
                margin-left: 20px;
            }

            nav ul li a {
                color: #e0e0e0;
                transition: color 0.3s;
            }

            nav ul li a:hover {
                color: #5abee0;
            }

            .search-bar {
                display: flex;
                background-color: #1a1d27;
                border-radius: 20px;
                overflow: hidden;
                width: 250px;
            }

            .search-bar input {
                width: 100%;
                padding: 8px 15px;
                border: none;
                background-color: transparent;
                color: #fff;
                outline: none;
            }

            .search-bar button {
                background-color: #5abee0;
                border: none;
                color: #161921;
                padding: 8px 15px;
                cursor: pointer;
            }

            /* Hero Section */
            .hero {
                margin-top: 20px;
                position: relative;
                height: 400px;
                border-radius: 10px;
                overflow: hidden;
            }

            .hero-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .hero-content {
                position: absolute;
                bottom: 0;
                left: 0;
                padding: 20px;
                width: 100%;
                background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
            }

            .hero-content h2 {
                font-size: 28px;
                margin-bottom: 10px;
            }

            .hero-content p {
                margin-bottom: 15px;
                color: #e0e0e0;
            }

            .watch-btn {
                background-color: #5abee0;
                color: #161921;
                padding: 8px 20px;
                border-radius: 20px;
                font-weight: bold;
                transition: background-color 0.3s;
                display: inline-block;
            }

            .watch-btn:hover {
                background-color: #4590ad;
            }

            /* Categories */
            .categories {
                margin-top: 40px;
            }

            .section-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .section-title h3 {
                font-size: 22px;
            }

            .view-all {
                color: #5abee0;
                font-size: 14px;
            }

            .category-list {
                display: flex;
                overflow-x: auto;
                padding-bottom: 15px;
                gap: 15px;
            }

            .category-card {
                background-color: #1a1d27;
                padding: 10px 20px;
                border-radius: 20px;
                flex-shrink: 0;
                cursor: pointer;
                transition: background-color 0.3s;
            }

            .category-card:hover {
                background-color: #5abee0;
                color: #161921;
            }

            /* Anime Grid */
            .anime-grid {
                margin-top: 40px;
            }

            /* Change this in your CSS */
            .anime-list {
                display: flex; /* Change from grid to flex */
                overflow-x: auto; /* Enable horizontal scrolling */
                gap: 20px;
                padding-bottom: 15px; /* Add some padding for the scrollbar */
                scroll-behavior: smooth; /* Optional: adds smooth scrolling */
            }

            @media (min-width: 1150px) {
                .anime-list {
                    justify-content: space-between; /* Reduce gap on smaller screens */
                }
            }

            .anime-card {
                flex: 0 0 200px;
                position: relative;
                border-radius: 8px;
                overflow: hidden;
                transition: transform 0.3s;
            }

            /* Optional: Custom scrollbar styling */
            .anime-list::-webkit-scrollbar {
                height: 8px;
            }

            .anime-list::-webkit-scrollbar-track {
                background: #1a1d27;
                border-radius: 4px;
            }

            .anime-list::-webkit-scrollbar-thumb {
                background: #5abee0;
                border-radius: 4px;
            }

            .anime-list::-webkit-scrollbar-thumb:hover {
                background: #4590ad;
            }

            .anime-card:hover {
                transform: translateY(-5px);
            }

            .anime-poster {
                width: 100%;
                height: 280px;
                object-fit: cover;
            }

            .anime-info {
                padding: 10px;
                background-color: #1a1d27;
            }

            .anime-title {
                font-size: 18px;
                font-weight: bold;
                margin-bottom: 5px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .anime-details {
                display: flex;
                justify-content: space-between;
                color: #e0e0e0;
                font-size: 12px;
            }

            .episode-count {
                position: absolute;
                top: 10px;
                right: 10px;
                background-color: rgba(0, 0, 0, 0.7);
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 12px;
            }

            .sub-dub {
                position: absolute;
                top: 10px;
                left: 10px;
                background-color: #5abee0;
                color: #161921;
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 12px;
                font-weight: bold;
            }

            /* Footer */
            footer {
                margin-top: 60px;
                background-color: #161921;
                padding: 30px 0;
                color: #e0e0e0;
                font-size: 14px;
                text-align: center;
            }

            /* Responsive */
            @media (max-width: 768px) {
                nav ul {
                    display: none;
                }

                .search-bar {
                    width: 150px;
                }

                .anime-list {
                    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                }
            }

            /* Add these responsive styles to your existing CSS */
            @media (max-width: 1024px) {
                .anime-poster {
                    height: 250px; /* Slightly smaller on medium screens */
                }

                .anime-card {
                    flex: 0 0 180px; /* Slightly narrower cards */
                }
            }

            @media (max-width: 768px) {
                .anime-poster {
                    height: 220px; /* Even smaller on tablet screens */
                }

                .anime-card {
                    flex: 0 0 160px; /* Narrower cards for tablets */
                }

                .anime-title {
                    font-size: 14px; /* Smaller font size */
                }
            }

            @media (max-width: 480px) {
                .anime-poster {
                    height: 190px; /* Much smaller on mobile */
                }

                .anime-card {
                    flex: 0 0 140px; /* Narrower cards for mobile */
                }

                .anime-title {
                    font-size: 12px;
                }

                .anime-details {
                    font-size: 10px;
                }

                .episode-count,
                .sub-dub {
                    font-size: 10px;
                    padding: 2px 6px;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <div class="container header-container">
                <div class="logo"><a class="logo" href="/">ANIXTREME</a></div>
                <nav>
                    <!-- <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">Anime</a></li>
                        <li><a href="#">Movies</a></li>
                        <li><a href="#">Recently Added</a></li>
                        <li><a href="#">My List</a></li>
                    </ul> -->
                </nav>
                <div class="search-bar">
                    <input id="search-bar-data" type="text" placeholder="Search anime..." />
                    <button id="search-bar-button">Search</button>
                </div>
            </div>
        </header>

        <main class="container">
            <section class="hero">
                <img src="/assets/poster.jpg" alt="Sword Art Online" class="hero-image" />
                <div class="hero-content">
                    <h2>Sword Art Online</h2>
                    <p>
                        In the near future, players of a virtual reality MMORPG called Sword Art
                        Online find themselves trapped in the game world and must fight to escape.
                    </p>
                    <a href="/anime/sword-art-online-2274" class="watch-btn">Watch Now</a>
                </div>
            </section>

            <section class="anime-grid">
                <div class="section-title">
                    <h3>Top Airing</h3>
                </div>
                <div class="anime-list">
                    <% topAiringAnimes.forEach(data => { %>
                    <a class="anime-card" href="/anime/<%= data.id %>">
                        <div class="anime-card">
                            <div class="sub-dub">
                                <% if (data.episodes.sub > 0 && data.episodes.dub <= 0) { %> SUB <%
                                } %> <% if (data.episodes.sub > 0 && data.episodes.dub > 0) { %>
                                SUB/DUB <% } %>
                            </div>
                            <div class="episode-count">EP <%= data.episodes.sub %></div>
                            <img src="<%= data.poster %>" alt="Anime Poster" class="anime-poster" />
                            <div class="anime-info">
                                <div class="anime-title"><%= data.name %></div>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </section>

            <section class="anime-grid">
                <div class="section-title">
                    <h3>Most Popular</h3>
                </div>
                <div class="anime-list">
                    <% mostPopularAnimes.forEach(data => { %>
                    <a class="anime-card" href="/anime/<%= data.id %>">
                        <div class="anime-card">
                            <div class="sub-dub">
                                <% if (data.episodes.sub > 0 && data.episodes.dub <= 0) { %> SUB <%
                                } %> <% if (data.episodes.sub > 0 && data.episodes.dub > 0) { %>
                                SUB/DUB <% } %>
                            </div>
                            <div class="episode-count">EP <%= data.episodes.sub %></div>
                            <img src="<%= data.poster %>" alt="Anime Poster" class="anime-poster" />
                            <div class="anime-info">
                                <div class="anime-title"><%= data.name %></div>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </section>
        </main>

        <script>
            const searchBar = document.getElementById('search-bar-data');
            const searchButton = document.getElementById('search-bar-button');
            const searchUrl = '/search?q=';

            searchButton.addEventListener('click', () => {
                const query = searchBar.value.trim();
                redirectToSearch(query);
            });

            searchBar.addEventListener('keypress', (event) => {
                if (event.key === 'Enter') {
                    const query = searchBar.value.trim();
                    redirectToSearch(query);
                }
            });

            function redirectToSearch(query) {
                if (query !== '') {
                    window.location.href = searchUrl + query + '&page=1';
                } else {
                    searchBar.value = '';
                }
            }
        </script>
        <footer>ANIXTREME, Made with ❤️ by SMXTREME</footer>
    </body>
</html>
